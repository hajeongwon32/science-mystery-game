{
  "name": "science-mystery-game",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "build": "tsc --noEmit && vite build && node scripts/standalone.mjs",
    "test": "node --test tests/ship-intro.test.ts",
    "check": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort"
  },
  "dependencies": {
    "express": "^5.3.0",
    "mysql2": "^3.24.6",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.11",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "prettier": "3.10.1",
    "typescript": "5.9.3",
    "vite": "7.3.8"
  }
}
